<?xml version="1.0"?>
<!--
  Robo Garcom completo no Gazebo: restaurante, P3-DX andando de verdade com A*,
  parada/desvio de obstaculos pelo laser, telas no navegador e RViz com a rota.

    roslaunch garcom_bringup gazebo.launch
    roslaunch garcom_bringup gazebo.launch auto_orders:=false auto_pickup:=false
      (voce faz os pedidos em http://localhost:8080/mesa e monta a bandeja em /bancada)

  Para testar o obstaculo, em outro terminal:
    rosrun garcom_simulation obstaculo.py         (cliente em pe na rota do robo)
    rosrun garcom_simulation obstaculo.py tirar
-->
<launch>
  <arg name="gui" default="true"/>
  <arg name="rviz" default="true"/>
  <arg name="auto_orders" default="true"/>
  <arg name="order_period_s" default="30"/>
  <arg name="auto_pickup" default="true"/>
  <arg name="deadline_s" default="600"/>
  <arg name="web" default="true"/>
  <arg name="web_port" default="8080"/>

  <include file="$(find garcom_simulation)/launch/mundo.launch">
    <arg name="gui" value="$(arg gui)"/>
  </include>

  <include file="$(find garcom_bringup)/launch/sim.launch">
    <arg name="navegacao" value="real"/>
    <arg name="speed" value="0.3"/>
    <arg name="auto_orders" value="$(arg auto_orders)"/>
    <arg name="order_period_s" value="$(arg order_period_s)"/>
    <arg name="auto_pickup" value="$(arg auto_pickup)"/>
    <arg name="deadline_s" value="$(arg deadline_s)"/>
    <arg name="web" value="$(arg web)"/>
    <arg name="web_port" value="$(arg web_port)"/>
  </include>

  <node if="$(arg rviz)" pkg="rviz" type="rviz" name="rviz"
        args="-d $(find garcom_simulation)/rviz/garcom.rviz"/>
</launch>
