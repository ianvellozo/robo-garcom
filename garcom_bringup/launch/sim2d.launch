<?xml version="1.0"?>
<!--
  Robo Garcom completo no simulador 2D leve (sem Gazebo): mesma navegacao real
  (A*, odometria, laser, parada/desvio), mesmas telas, RViz com o mapa e a rota.
  Bom para computador fraco ou para testar rapido.

    roslaunch garcom_bringup sim2d.launch
    rosrun garcom_simulation obstaculo.py         (em outro terminal: cliente na rota)
-->
<launch>
  <arg name="rviz" default="true"/>
  <arg name="visual" default="true"/>
  <arg name="auto_orders" default="true"/>
  <arg name="order_period_s" default="30"/>
  <arg name="auto_pickup" default="true"/>
  <arg name="deadline_s" default="600"/>
  <arg name="web" default="true"/>
  <arg name="web_port" default="8080"/>

  <include file="$(find garcom_simulation)/launch/simulador_2d.launch">
    <arg name="visual" value="$(arg visual)"/>
  </include>

  <include file="$(find garcom_bringup)/launch/sim.launch">
    <arg name="navegacao" value="real"/>
    <arg name="speed" value="0.3"/>
    <arg name="auto_orders" value="$(arg auto_orders)"/>
    <arg name="order_period_s" value="$(arg order_period_s)"/>
    <arg name="auto_pickup" value="$(arg auto_pickup)"/>
    <arg name="deadline_s" value="$(arg deadline_s)"/>
    <arg name="web" value="$(arg web)"/>
    <arg name="web_port" value="$(arg web_port)"/>
  </include>

  <node if="$(arg rviz)" pkg="rviz" type="rviz" name="rviz"
        args="-d $(find garcom_simulation)/rviz/garcom.rviz"/>
</launch>
